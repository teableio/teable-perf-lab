    {
      "id": "4c4cfd15082ee255",
      "parentId": "78e04cef6bfe7c75",
      "name": "pg.query:SELECT e2e_test_teable",
      "service": "teable-perf-v2-sync-shard-8-of-8-v2",
      "startUs": 1789803116735000,
      "durationUs": 88573,
      "tags": {
        "db.namespace": "e2e_test_teable",
        "db.query.text": "select \"ws\".\"id\" as \"id\", \"ws\".\"workflow_id\" as \"workflowId\", ws.snapshot->>'name' as \"name\", ws.snapshot->>'baseId' as \"baseId\", (\n        SELECT elem\n        FROM jsonb_array_elements(ws.snapshot->'nodes') elem\n        WHERE elem->>'category' = $1\n        LIMIT 1\n      ) as \"trigger\" from \"workflow\" as \"w\" inner join \"workflow_snapshot\" as \"ws\" on \"w\".\"active_snapshot_id\" = \"ws\".\"id\" where \"w\".\"is_active\" = $2 and \"w\".\"subscribe_resource_id\" = $3 and \"w\".\"subscribe_trigger_type\" in ($4, $5, $6, $7, $8, $9) and \"w\".\"deleted_time\" is null",
        "db.system.name": "postgresql",
        "otel.scope.name": "@opentelemetry/instrumentation-pg",
