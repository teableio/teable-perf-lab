{
  "id": "ds_large_v1",
  "name": "large",
  "description": "Breakpoint and search: 10M rows, 300 columns, wide rows. Use snapshot restore or direct DB seeding, not the API seeder.",
  "rows": 10000000,
  "method": "snapshot",
  "table": {
    "name": "stress_large",
    "fields": [
      { "name": "Name", "type": "singleLineText" },
      { "name": "Email", "type": "singleLineText" },
      { "name": "Status", "type": "singleSelect", "options": { "choices": [{ "name": "Todo" }, { "name": "InProgress" }, { "name": "Done" }, { "name": "Blocked" }] } },
      { "name": "Priority", "type": "singleSelect", "options": { "choices": [{ "name": "P0" }, { "name": "P1" }, { "name": "P2" }, { "name": "P3" }] } },
      { "name": "Tags", "type": "multipleSelect", "options": { "choices": [{ "name": "Red" }, { "name": "Green" }, { "name": "Blue" }, { "name": "Yellow" }] } },
      { "name": "Amount", "type": "number" },
      { "name": "Quantity", "type": "number" },
      { "name": "Score", "type": "rating", "options": { "icon": "star", "color": "yellowBright", "max": 5 } },
      { "name": "DueDate", "type": "date" },
      { "name": "Active", "type": "checkbox" },
      { "name": "Notes", "type": "longText" },
      { "name": "Region", "type": "singleSelect", "options": { "choices": [{ "name": "APAC" }, { "name": "EMEA" }, { "name": "AMER" }] } }
    ],
    "repeat": [
      { "count": 288, "namePrefix": "Metric", "type": "number" }
    ]
  },
  "generation": { "batchSize": 500, "seed": 42 },
  "checks": { "rowCount": 10000000, "sampleSize": 100 }
}
