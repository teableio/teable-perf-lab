{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-headless-bench",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": false,
    "rootDir": "../../..",
    "paths": {
      "@teable/core": ["../../core/src"],
      "@teable/v2-complexity": ["../complexity/src"],
      "@teable/v2-data-query": ["../data-query/src"],
      "@teable/v2-dottea": ["../dottea/src"],
      "@teable/v2-adapter-table-repository-postgres": ["../adapter-table-repository-postgres/src"],
      "@teable/v2-adapter-db-postgres-shared": ["../adapter-db-postgres-shared/src"],
      "@teable/v2-contract-http-client": ["../contract-http-client/dist/index.d.ts"],
      "@teable/v2-contract-http-hono": ["../contract-http-hono/dist/index.d.ts"],
      "@teable/v2-headless-http": ["../headless-http/src"],
      "@teable/v2-headless-runtime": ["../headless-runtime/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-di": ["../di/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": ["**/node_modules", "**/.*/", "./dist", "./coverage"],
  "include": ["src"]
}
